# Copiar a api/.env solo en el kiosco. Este archivo NO debe contener claves reales.
# api/.env está ignorado por Git. Nunca usar variables VITE_ para credenciales.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURITY admite starttls (587) o ssl (465). No se admite envío sin TLS.
# Usuario/contraseña pueden quedar vacíos si el servidor permite relay autenticado por red.
# Administrador: ejecutar python api/setup_admin.py y reiniciar la API.
# El asistente guarda ADMIN_PASSWORD_HASH en api/.env; nunca compartir su valor.
# No copiar este ejemplo sobre un api/.env ya configurado.
# API local: no admite 0.0.0.0 ni direcciones de red.
MOCK_HOST=127.0.0.1
MOCK_PORT=8787
# Si cambias el puerto del frontend: orígenes exactos separados por coma.
# Vite (1420) y Tauri ya están permitidos por defecto.
API_ALLOWED_ORIGINS=
